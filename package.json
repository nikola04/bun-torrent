{
    "name": "bun-torrent",
    "version": "0.0.3-beta",
    "type": "module",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "license": "MIT",
    "description": "A minimal Bun-native BitTorrent download-only client.",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nikola04/bun-torrent.git"
    },
    "bugs": {
        "url": "https://github.com/nikola04/bun-torrent/issues"
    },
    "homepage": "https://github.com/nikola04/bun-torrent#readme",
    "keywords": [
        "bun",
        "bittorrent",
        "torrent",
        "download",
        "typescript"
    ],
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "bun run typecheck && bun run build && bun run lint && bun run format:check && bun test",
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "prepack": "bun run build",
        "app": "bun src/app.ts"
    },
    "engines": {
        "bun": ">=1.3.0"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "latest",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "prettier": "3.8.3",
        "typescript": "^5",
        "typescript-eslint": "^8.59.3"
    }
}
