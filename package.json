{
    "name": "bun-torrent",
    "version": "0.0.1-beta",
    "type": "module",
    "module": "src/index.ts",
    "license": "MIT",
    "description": "A minimal Bun-native BitTorrent download-only client.",
    "keywords": [
        "bun",
        "bittorrent",
        "torrent",
        "download",
        "typescript"
    ],
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
        "app": "bun src/app.ts"
    },
    "engines": {
        "bun": ">=1.3.0"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "sideEffects": false,
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "latest",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "prettier": "3.8.3",
        "typescript": "^5",
        "typescript-eslint": "^8.59.3"
    }
}
